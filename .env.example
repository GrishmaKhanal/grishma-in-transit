# Copy to .env for local dev. On a host, set the same keys in its environment
# variable settings (see docs/deploy/env-vars.md). Never commit real values.

# Any Postgres connection string: local podman, Netlify Database, Neon, Supabase, RDS...
# Remote hosts get sslmode=verify-full unless the URL sets sslmode=disable or no-verify.
DATABASE_URL=
# Optional: a direct (non-pooled) URL, used only by migrations when the host offers one.
DATABASE_URL_UNPOOLED=

# `true` makes `npm run build` apply pending migrations first. Set it in production only.
RUN_MIGRATIONS=

# Secret admin URL. Pick something unguessable (e.g. `/studio-$(openssl rand -hex 4)`).
# /admin itself always 404s. Leave empty to disable the admin entirely.
ADMIN_PATH=

# Admin login (both required; username is case-insensitive)
ADMIN_USERNAME=
# 16+ characters or login stays disabled, e.g. `openssl rand -base64 24`
ADMIN_PASSWORD=
# 32+ random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Public origin, used for absolute links in the sitemap, RSS, canonical tags and OG images
SITE_URL=http://localhost:3000

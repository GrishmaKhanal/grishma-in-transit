# Copy to .env for local dev, or pull from Vercel: `npx vercel env pull .env`

# Neon Postgres — added automatically by Vercel → Storage → Neon
DATABASE_URL=

# Vercel Blob (image uploads) — added automatically by Vercel → Storage → Blob
BLOB_READ_WRITE_TOKEN=

# Admin login at /makemeaadmin
ADMIN_PASSWORD=
# 32+ random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Canonical domain used in sitemap, RSS, canonical & OG URLs
NEXT_PUBLIC_SITE_URL=https://grishmakhanal.com.np

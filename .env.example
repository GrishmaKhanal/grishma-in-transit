# Copy to .env for local dev, or pull from Vercel: `npx vercel env pull .env`

# Neon Postgres — added automatically by Vercel → Storage → Neon
DATABASE_URL=
# Direct (non-pooled) URL, also injected by the Neon integration. Used for migrations only.
DATABASE_URL_UNPOOLED=

# Vercel Blob (image uploads) — added automatically by Vercel → Storage → Blob
BLOB_READ_WRITE_TOKEN=

# Secret admin URL. Pick something unguessable (e.g. `/studio-$(openssl rand -hex 4)`).
# /admin itself always 404s. Leave empty to disable the admin entirely.
ADMIN_PATH=

# Admin login (both required; username is case-insensitive)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 32+ random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Canonical domain used in sitemap, RSS, canonical & OG URLs
NEXT_PUBLIC_SITE_URL=https://grishmakhanal.com.np
